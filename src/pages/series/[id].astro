---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { SITE } from '../../astro/site.js';
import { getAllSeriesForIndex, getSeriesById } from '../../data/related.js';

export const prerender = true;

export function getStaticPaths() {
  return getAllSeriesForIndex().map((series) => ({
    params: { id: series.id },
    props: { seriesId: series.id },
  }));
}

const { seriesId } = Astro.props;
const series = getSeriesById(seriesId);
if (!series) {
  throw new Error(`Unknown series: ${seriesId}`);
}

const path = series.href;
const otherSeries = getAllSeriesForIndex().filter((item) => item.id !== series.id);
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: series.title,
  description: series.description,
  numberOfItems: series.count,
  itemListElement: series.items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    url: `${SITE}${item.href}`,
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Series', item: `${SITE}/series` },
    { '@type': 'ListItem', position: 3, name: series.title, item: `${SITE}${path}` },
  ],
};
---
<BaseLayout
  title={`${series.title} - Storewise`}
  description={series.description}
  path={path}
  breadcrumbs={[
    { name: 'Home', item: SITE },
    { name: 'Series', item: `${SITE}/series` },
    { name: series.title },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Hero
    title={series.title}
    titleZh={series.titleZh}
    sub={series.description}
    subZh={series.descriptionZh}
    eyebrow={`Series · ${series.count} guides`}
    eyebrowZh={`系列 · ${series.count} 篇`}
  />

  <section class="articleToolbar card seriesHubMeta">
    <div class="lang-en">
      <h2>Who this series is for</h2>
      <p>{series.audience}</p>
      <h2>When to use it</h2>
      <p>{series.whenToUse}</p>
    </div>
    <div class="lang-zh">
      <h2>适合谁</h2>
      <p lang="zh-CN">{series.audienceZh}</p>
      <h2>何时使用</h2>
      <p lang="zh-CN">{series.whenToUseZh}</p>
    </div>
    <div class="seriesHubActions">
      <a class="homeSectionCta" href={series.startHref}>
        <span class="lang-en">Start with guide 1</span>
        <span class="lang-zh">从第 1 篇开始</span>
      </a>
      <a class="homeSectionCta secondary" href="/series">
        <span class="lang-en">All series</span>
        <span class="lang-zh">全部系列</span>
      </a>
      {series.latestUpdated && (
        <span class="seriesHubStamp lang-en">Latest guide update {series.latestUpdated}</span>
      )}
      {series.latestUpdated && (
        <span class="seriesHubStamp lang-zh">最近指南更新 {series.latestUpdated}</span>
      )}
    </div>
  </section>

  <section class="richSection card" aria-label="Exit criteria">
    <div class="homeSectionHead">
      <div>
        <h2 class="lang-en">Exit criteria</h2>
        <h2 class="lang-zh">完成标准</h2>
        <p class="lang-en contentLead">You can leave this series once these outcomes are true — no need to force every guide.</p>
        <p class="lang-zh contentLead">达到这些结果即可离开本系列，不必硬读完每一篇。</p>
      </div>
    </div>
    <ul class="seriesExitList">
      {series.exitCriteria.map((item, index) => (
        <li>
          <span class="seriesStep">{index + 1}</span>
          <div>
            <p class="lang-en">{item}</p>
            <p class="lang-zh">{series.exitCriteriaZh[index] || item}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="richSection card homeDeepGuides" aria-label="Guides in this series">
    <div class="homeSectionHead">
      <div>
        <h2 class="lang-en">Guides in order</h2>
        <h2 class="lang-zh">按顺序阅读</h2>
        <p class="lang-en contentLead">Follow the numbers. Each guide links previous / next for the same decision flow.</p>
        <p class="lang-zh contentLead">按编号阅读。每篇都会链接同一决策流程的上一篇 / 下一篇。</p>
      </div>
    </div>
    <ol class="seriesList seriesHubList">
      {series.items.map((item, index) => (
        <li>
          <a href={item.href}>
            <span class="seriesStep">{index + 1}</span>
            <span class="seriesHubItemBody">
              <strong class="lang-en">{item.title}</strong>
              <strong class="lang-zh">{item.titleZh}</strong>
              <span class="lang-en">{item.description}</span>
              <span class="lang-zh">{item.descriptionZh}</span>
              <small class="lang-en">{item.category} · {item.readTime} · Updated {item.updatedAt}</small>
              <small class="lang-zh">{item.category} · {item.readTime} · 更新于 {item.updatedAt}</small>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {series.relatedTools?.length > 0 && (
    <section class="relatedBlock card" aria-label="Optional tools for this series">
      <h2 class="lang-en">Optional tools after research</h2>
      <h2 class="lang-zh">研究后的可选工具</h2>
      <p class="lang-en contentLead">Open only if a number, deadline, or risk note helps. Official Apple screens still win.</p>
      <p class="lang-zh contentLead">仅在数字、截止日或风险备注有用时打开。官方 Apple 界面仍优先。</p>
      <div class="contentLinks" style="border-top:0;margin-top:0;padding-top:0;">
        {series.relatedTools.map((tool) => (
          <a href={tool.href}>
            <span class="lang-en">{tool.label}</span>
            <span class="lang-zh">{tool.labelZh}</span>
          </a>
        ))}
        <a href="/articles">
          <span class="lang-en">All articles</span>
          <span class="lang-zh">全部文章</span>
        </a>
      </div>
    </section>
  )}

  <section class="relatedBlock card" aria-label="Other series">
    <h2 class="lang-en">Other series</h2>
    <h2 class="lang-zh">其他系列</h2>
    <div class="seriesIndexGrid">
      {otherSeries.map((item) => (
        <article class="seriesIndexCard">
          <h3 class="lang-en">{item.title}</h3>
          <h3 class="lang-zh">{item.titleZh}</h3>
          <p class="lang-en">{item.description}</p>
          <p class="lang-zh">{item.descriptionZh}</p>
          <a class="homeSectionCta" href={item.href}>
            <span class="lang-en">Open series</span>
            <span class="lang-zh">打开系列</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

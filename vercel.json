{
  "buildCommand": "npm run build",
  "outputDirectory": "deploy-build",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/price",
      "destination": "/articles/app-store-price-check-before-buying",
      "permanent": true
    },
    {
      "source": "/price/",
      "destination": "/articles/app-store-price-check-before-buying",
      "permanent": true
    },
    {
      "source": "/appfree",
      "destination": "/articles/when-not-to-install-free-apps",
      "permanent": true
    },
    {
      "source": "/appfree/",
      "destination": "/articles/when-not-to-install-free-apps",
      "permanent": true
    },
    {
      "source": "/subcost",
      "destination": "/articles/manage-apple-subscriptions-after-trial",
      "permanent": true
    },
    {
      "source": "/subcost/",
      "destination": "/articles/manage-apple-subscriptions-after-trial",
      "permanent": true
    },
    {
      "source": "/trial",
      "destination": "/articles/free-trial-trap-checklist",
      "permanent": true
    },
    {
      "source": "/trial/",
      "destination": "/articles/free-trial-trap-checklist",
      "permanent": true
    },
    {
      "source": "/icon",
      "destination": "/articles/spot-low-quality-app-store-listings",
      "permanent": true
    },
    {
      "source": "/icon/",
      "destination": "/articles/spot-low-quality-app-store-listings",
      "permanent": true
    },
    {
      "source": "/iap",
      "destination": "/articles/understand-in-app-purchases",
      "permanent": true
    },
    {
      "source": "/iap/",
      "destination": "/articles/understand-in-app-purchases",
      "permanent": true
    }
  ]
}
